# Custom Risk local environment example.
# Copy this file to .env for local development and replace every placeholder.
# Do not commit .env or real secrets.

# App runtime.
NODE_ENV=development
PORT=3000

# PostgreSQL connection used by the backend and Prisma.
# Use localhost when running the backend directly on your machine.
# Docker Compose may override the host to db for container-to-container access.
DATABASE_URL=postgresql://customrisk:change_me@localhost:5432/customrisk

# Local PostgreSQL service settings.
POSTGRES_DB=customrisk
POSTGRES_USER=customrisk
POSTGRES_PASSWORD='change_me'

# JWT secrets must be random values of at least 256 bits.
JWT_ACCESS_SECRET='replace_with_256_bit_random_value'
JWT_REFRESH_SECRET='replace_with_256_bit_random_value'
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY_DAYS=30

# Password hashing cost factor.
BCRYPT_COST_FACTOR=12

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOGIN=10

# Local/dev seed password for the default System Admin.
# If the password contains `$`, spaces, or shell-special characters,
# wrap the value in single quotes in `.env`.
SEED_ADMIN_EMAIL=admin@customrisk.local
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PASSWORD='replace_with_local_dev_password'

# Set true to also seed demo users (Alice, Bob, Carol), two example registers,
# and representative sample risks. Recommended for local development.
SEED_DEMO_DATA=true

# Optional shared local/dev password for demo users Alice, Bob, and Carol.
# When omitted, demo users are created with random non-printed passwords.
# Quote the value in `.env` if it contains `$` or other shell-special characters.
SEED_DEMO_USER_PASSWORD='replace_with_local_demo_password'

# Post-MVP feature flags — set to true only when the phase is complete and tested.
# Phase 1: user preferences and dark mode
FEATURE_USER_PREFERENCES=false
# Phase 3: SAML authentication
FEATURE_SAML_AUTH=false
# Phase 4: draft/publish configuration versioning
FEATURE_DRAFT_CONFIG=false
# Phase 7: child-record risk response actions
FEATURE_CHILD_ACTIONS=false
# Phase 9: in-app and email notifications
FEATURE_NOTIFICATIONS=false
# Phase 10: CSV import wizard
FEATURE_CSV_IMPORT=false
# Phase 12: file attachments and evidence
FEATURE_ATTACHMENTS=false
# Phase 13: API keys
FEATURE_API_KEYS=false
# Phase 13: webhooks
FEATURE_WEBHOOKS=false
# Phase 11: saved views
FEATURE_SAVED_VIEWS=false
