# Custom Risk — deployment environment template
#
# Copy this file to .env and fill in all required values before running:
#
#   docker compose -f docker-compose.release.yml up -d
#
# Required values are marked [REQUIRED]. All others have safe defaults.
# Generate JWT secrets with: openssl rand -hex 32

# -------------------------------------------------------------------
# Image version (optional — defaults to latest)
# Pin to a specific release tag for reproducible deployments, e.g. 0.1.4
# -------------------------------------------------------------------
# CUSTOMRISK_VERSION=latest

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Set this to the URL your users will access the app from.
# [REQUIRED]
CORS_ALLOWED_ORIGINS=https://risk.example.com

# -------------------------------------------------------------------
# Database (bundled PostgreSQL)
# These values configure the postgres container and the connection
# string used by the app. If you are using an external database,
# remove the db service from docker-compose.release.yml and set
# DATABASE_URL directly instead of these variables.
# -------------------------------------------------------------------
POSTGRES_DB=customrisk
POSTGRES_USER=customrisk
# [REQUIRED] — set a strong random password
POSTGRES_PASSWORD=

# -------------------------------------------------------------------
# JWT signing secrets
# Generate with: openssl rand -hex 32
# [REQUIRED]
# -------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY_DAYS=30

# -------------------------------------------------------------------
# Security
# -------------------------------------------------------------------
BCRYPT_COST_FACTOR=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOGIN=10

# -------------------------------------------------------------------
# Initial admin account
# On first container start, if SEED_ADMIN_PASSWORD is set the app will
# create an admin account using these values. Re-running with the same
# password is safe (the account is upserted, not duplicated).
# Leave SEED_ADMIN_PASSWORD unset to skip seeding entirely.
# -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@customrisk.local
SEED_ADMIN_NAME=System Admin
# [REQUIRED for first-run setup] — must meet the password policy
SEED_ADMIN_PASSWORD=
