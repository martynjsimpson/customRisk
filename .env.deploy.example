# Custom Risk — deployment environment template
#
# Copy this file to .env and fill in the three required values marked [REQUIRED].
# Everything else has a working default or is auto-generated.
#
#   cp .env.example .env
#   docker compose up -d

# -------------------------------------------------------------------
# Admin account  [REQUIRED for first-run access]
# The container creates or updates this account on every start.
# Password and display name are only written on first creation —
# subsequent restarts do not overwrite them.
# Leave SEED_ADMIN_PASSWORD unset to skip all seeding.
# -------------------------------------------------------------------
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@customrisk.local
SEED_ADMIN_NAME=System Admin

# -------------------------------------------------------------------
# Database password  [REQUIRED]
# Used only within the private Docker network between the app and the
# bundled PostgreSQL container. Set any strong password.
# -------------------------------------------------------------------
POSTGRES_PASSWORD=

# -------------------------------------------------------------------
# Allowed origins  [REQUIRED]
# The URL(s) users will access the app from. Comma-separated.
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://risk.example.com

# -------------------------------------------------------------------
# Demo data (optional)
# Set SEED_DEMO_DATA=true to create demo users, two example registers,
# and representative sample risks alongside the admin account.
# Requires SEED_ADMIN_PASSWORD to be set.
# Set SEED_DEMO_USER_PASSWORD to give demo users a known login password.
# -------------------------------------------------------------------
# SEED_DEMO_DATA=true
# SEED_DEMO_USER_PASSWORD=

# -------------------------------------------------------------------
# JWT signing secrets (optional — auto-generated on first start)
# Generated secrets are stored in the data volume and reused on every
# restart. Set these only if you need to rotate secrets or run multiple
# app instances. Generate with: openssl rand -hex 32
# -------------------------------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# -------------------------------------------------------------------
# External database (optional — bundled PostgreSQL is used if not set)
# Uncomment DATABASE_URL and set it to your connection string, then
# remove the `db` service block from the downloaded docker-compose.yml.
# -------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/database

# -------------------------------------------------------------------
# Advanced (optional — defaults are suitable for most deployments)
# -------------------------------------------------------------------
# CUSTOMRISK_VERSION=latest
# PORT=3000
# POSTGRES_DB=customrisk
# POSTGRES_USER=customrisk
# JWT_ACCESS_EXPIRY=60m
# JWT_REFRESH_EXPIRY_DAYS=30
# BCRYPT_COST_FACTOR=12
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_LOGIN=10
