{
  "name": "custom-risk",
  "version": "1.26.0",
  "private": true,
  "description": "Custom Risk MVP monorepo.",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev:backend": "npm --workspace @custom-risk/backend run dev",
    "dev:frontend": "npm --workspace @custom-risk/frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm --workspace @custom-risk/backend run test",
    "test:frontend": "npm --workspace @custom-risk/frontend run test",
    "test:shared": "npm --workspace @custom-risk/shared run test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:backend": "npm --workspace @custom-risk/backend run typecheck",
    "typecheck:frontend": "npm --workspace @custom-risk/frontend run typecheck",
    "typecheck:shared": "npm --workspace @custom-risk/shared run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "npm --workspace @custom-risk/backend run prisma:deploy",
    "db:setup": "npm run db:migrate && npm run seed:admin",
    "seed:admin": "npm --workspace @custom-risk/backend run prisma:seed",
    "smoke-test": "sh scripts/smoke-test.sh",
    "e2e": "playwright test",
    "e2e:seed": "npx tsx --env-file=.env e2e/fixtures/seed.ts",
    "e2e:teardown": "npx tsx e2e/fixtures/teardown.ts",
    "show-report": "npx playwright show-report --host 127.0.0.1"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript-eslint": "^8.65.0"
  }
}
